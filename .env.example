# Copy to .env and replace the placeholders. Never commit .env.

# Postgres (local only)
POSTGRES_DB=cimiento
POSTGRES_USER=cimiento
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Kafka
KAFKA_PORT=9092

# Role keys for the core API (phase 2). Placeholders only.
CIMIENTO_AGENT_KEY=replace-with-random-value
CIMIENTO_ANALYST_KEY=replace-with-random-value
CIMIENTO_REVIEWER_KEY=replace-with-random-value

# Agents search index (own database, created by deploy/postgres/init.sql).
CIMIENTO_SEARCH_DSN=postgresql://cimiento:change-me@localhost:5432/cimiento_search
CIMIENTO_SEARCH_THRESHOLDS=evals/config/search.json

# Optional: YOUR OWN Anthropic API key (billed to your account). Without it the agents use the
# deterministic fake model and cost nothing. Never commit a real key; .env is git-ignored.
ANTHROPIC_API_KEY=
CIMIENTO_RECORD=false
